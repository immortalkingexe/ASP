# Application Configuration
NEXT_PUBLIC_APP_NAME="Automated Student Planner"
# Set NEXT_PUBLIC_SITE_URL in production (e.g., https://your-app.vercel.app) for Supabase Auth redirect URLs
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Future Integration Placeholders

# Module 2: Authentication (Supabase Auth Placeholder)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Module 3: Database (Supabase PostgreSQL Placeholder)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Module 4: Primary AI Engine (Google Gemini API - OpenAI Compatible)
GEMINI_API_KEY=
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MODEL="gemini-2.5-flash"

# Module 4b: Fallback AI Engine (NVIDIA NIM Hosted API)
NVIDIA_API_KEY=
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# Document Extraction Service (FastAPI)
EXTRACTION_SERVICE_URL="http://localhost:8000"
DOCUMENT_EXTRACTION_SERVICE_URL="http://localhost:8000"

# High-Confidence Strict Hybrid RAG Engine Configuration
RAG_HIGH_CONFIDENCE_THRESHOLD="0.50"
RAG_MEDIUM_CONFIDENCE_THRESHOLD="0.25"
RAG_DEBUG="true"


